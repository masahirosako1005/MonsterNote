# infra/.env.local の見本（値は空のまま。本物の値は infra/.env.local に書く。.env.local は .gitignore で除外している）
# cdk deploy の出力（Outputs）から写す
HUNTER_URL=
REQUESTER_URL=
API_URL=
# アラームのメールの宛先（cdk deploy -c alarmEmail=... で渡す）
ALARM_EMAIL=
# スモーク用の試験のアカウント（npm run account:create で作る。smoke-hunter・smoke-requester）
SMOKE_HUNTER_LOGIN_ID=
SMOKE_HUNTER_PASSWORD=
SMOKE_REQUESTER_LOGIN_ID=
SMOKE_REQUESTER_PASSWORD=
